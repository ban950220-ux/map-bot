#!/bin/sh
# Repository-local guard; server protections and API permissions remain separate.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "Direct default-branch pushes are blocked. Use a reviewed PR." >&2
      exit 1
      ;;
  esac
done
exit 0
